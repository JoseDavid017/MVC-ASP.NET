@model List<ApplianceCare.Models.Repair>

@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <title>Repair</title>
</head>
<body>
    <div class="container">
        <h1>Repair Services</h1>
        <p>The following are the products that need  repair services:</p>
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Description</th>
                    <th>Date</th>
                    <th>Time</th>
                    <th>Cost</th>
                    <th>Appliance Care</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var repair in Model)
            {
                    <tr>
                        <td>@repair.description</td>
                        <td>@repair.Date</td>
                        <td>@repair.time</td>
                        <td>@repair.cost</td>
                        <td>@repair.ApplianceCare</td>
                    </tr>
            }

            </tbody>
        </table>
    </div>
</body>
</html>
